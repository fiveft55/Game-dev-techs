# Tell whether a character can see another tile without a wall blocking the view.
# line-of-sight: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width,height,start_x,start_y,goal_x,goal_y,...grid]
# Output: [visible_flag]
# Integer tile centers; zero is transparent. Corner ties test both side cells to prevent diagonal
# wall leaks.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Remove a negative sign so a distance or size is not negative.
static func port_abs_num(a: float) -> float:
    return absf(a)

# 1. Walk a straight line from the starting tile center to the target tile center.
# 2. Check every tile touched by the line.
# 3. When the line crosses a corner, check both side tiles too.
# 4. Any wall blocks sight. This prevents seeing through two walls that meet diagonally.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var x: float = 0.0
    var y: float = 0.0
    var gx: float = 0.0
    var gy: float = 0.0
    var nx: float = 0.0
    var ny: float = 0.0
    var sx: float = 0.0
    var sy: float = 0.0
    var ix: float = 0.0
    var iy: float = 0.0
    var decision: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    x = port_get(data, 2.0)
    y = port_get(data, 3.0)
    gx = port_get(data, 4.0)
    gy = port_get(data, 5.0)
    if ((w < 1.0) or (h < 1.0) or (port_length(data) != (6.0 + (w * h)))):
        return [-(1.0)]
    if ((x < 0.0) or (y < 0.0) or (gx < 0.0) or (gy < 0.0) or (x >= w) or (gx >= w) or (y >= h) or (gy >= h)):
        return [0.0]
    if ((port_get(data, ((6.0 + (y * w)) + x)) != 0.0) or (port_get(data, ((6.0 + (gy * w)) + gx)) != 0.0)):
        return [0.0]
    nx = port_abs_num((gx - x))
    ny = port_abs_num((gy - y))
    sx = -(1.0)
    sy = -(1.0)
    if (gx > x):
        sx = 1.0
    if (gy > y):
        sy = 1.0
    ix = 0.0
    iy = 0.0
    while ((ix < nx) or (iy < ny)):
        decision = (((1.0 + (2.0 * ix)) * ny) - ((1.0 + (2.0 * iy)) * nx))
        if (decision == 0.0):
            if ((port_get(data, (((6.0 + (y * w)) + x) + sx)) != 0.0) or (port_get(data, ((6.0 + ((y + sy) * w)) + x)) != 0.0)):
                return [0.0]
            x += sx
            y += sy
            ix += 1.0
            iy += 1.0
        else:
            if (decision < 0.0):
                x += sx
                ix += 1.0
            else:
                y += sy
                iy += 1.0
        if (port_get(data, ((6.0 + (y * w)) + x)) != 0.0):
            return [0.0]
    return [1.0]
