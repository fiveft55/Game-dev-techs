# Find nearby objects by grouping their positions into imaginary square boxes.
# spatial-hash: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [cell_size, query_x, query_y, ...[id,x,y]]
# Output: [...candidate_ids_in_input_order]
# Build point-cell coordinates and query a 3x3 neighborhood. Flat buckets are scanned here for
# clarity; unlike the Python dictionary, this reference is O(n) per query.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)
# Remove a negative sign so a distance or size is not negative.
static func port_abs_num(a: float) -> float:
    return absf(a)

# 1. Choose the size of each imaginary box.
# 2. Work out which box contains the search position.
# 3. Find objects in that box or any of its eight neighboring boxes.
# 4. These are possible neighbors, not guaranteed touching objects. Check exact distance
# afterward.
static func compute(data: Array) -> Array:
    var size: float = 0.0
    var qx: float = 0.0
    var qy: float = 0.0
    var result: Array = []
    var i: float = 0.0
    var cx: float = 0.0
    var cy: float = 0.0
    size = port_get(data, 0.0)
    if (size <= 0.0):
        return [-(1.0)]
    qx = port_floor_num((port_get(data, 1.0) / size))
    qy = port_floor_num((port_get(data, 2.0) / size))
    result = []
    i = 3.0
    while (i < port_length(data)):
        cx = port_floor_num((port_get(data, (i + 1.0)) / size))
        cy = port_floor_num((port_get(data, (i + 2.0)) / size))
        if ((port_abs_num((cx - qx)) <= 1.0) and (port_abs_num((cy - qy)) <= 1.0)):
            port_push(result, port_get(data, i))
        i += 3.0
    return result
