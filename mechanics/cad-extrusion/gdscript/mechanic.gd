# Give a flat outline height to make a simple solid-looking 3D shape.
# cad-extrusion: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [height,...[profile_x,profile_y]]
# Output: [vertex_count,triangle_count,...xyz_vertices,...triangle_indices]
# Convex simple counterclockwise profile, nonduplicate vertices. Same outward winding as the
# Python mesh. Not a robust CAD kernel.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Copy the outline at floor height and at the requested top height.
# 2. Cover the bottom and top with triangles.
# 3. Connect matching bottom and top edges with more triangles.
# 4. Return points and triangle point-numbers. The outline must be simple, convex, and listed
# counterclockwise.
static func compute(data: Array) -> Array:
    var height: float = 0.0
    var n: float = 0.0
    var result: Array = []
    var layer: float = 0.0
    var i: float = 0.0
    var j: float = 0.0
    height = port_get(data, 0.0)
    n = ((port_length(data) - 1.0) / 2.0)
    if ((height <= 0.0) or (n < 3.0) or (port_floor_num(n) != n)):
        return [-(1.0)]
    result = [(2.0 * n), ((4.0 * n) - 4.0)]
    layer = 0.0
    while (layer < 2.0):
        i = 0.0
        while (i < n):
            port_push(result, port_get(data, (1.0 + (i * 2.0))))
            port_push(result, port_get(data, (2.0 + (i * 2.0))))
            port_push(result, (layer * height))
            i += 1.0
        layer += 1.0
    i = 1.0
    while (i < (n - 1.0)):
        port_push(result, 0.0)
        port_push(result, (i + 1.0))
        port_push(result, i)
        port_push(result, n)
        port_push(result, (n + i))
        port_push(result, ((n + i) + 1.0))
        i += 1.0
    i = 0.0
    while (i < n):
        j = port_mod_num((i + 1.0), n)
        port_push(result, i)
        port_push(result, j)
        port_push(result, (n + j))
        port_push(result, i)
        port_push(result, (n + j))
        port_push(result, (n + i))
        i += 1.0
    return result
