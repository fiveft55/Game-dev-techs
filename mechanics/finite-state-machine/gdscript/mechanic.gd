# Let a character switch between named situations, such as idle and jumping, using clear rules.
# finite-state-machine: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [initial_state, transition_count, ...[from,event,to], ...events]
# Output: [final_state, accepted_count]
# Integer state/event IDs. First matching transition wins. Unknown events are ignored.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])

# 1. Keep one current state, represented here by a number.
# 2. Read the next event, such as a jump button press.
# 3. Find a rule matching the current state and that event.
# 4. Switch to the rule destination. If no rule matches, keep the old state.
static func compute(data: Array) -> Array:
    var state: float = 0.0
    var count: float = 0.0
    var offset: float = 0.0
    var accepted: float = 0.0
    var i: float = 0.0
    var event_id: float = 0.0
    var j: float = 0.0
    var base_index: float = 0.0
    state = port_get(data, 0.0)
    count = port_get(data, 1.0)
    offset = (2.0 + (count * 3.0))
    accepted = 0.0
    i = offset
    while (i < port_length(data)):
        event_id = port_get(data, i)
        j = 0.0
        while (j < count):
            base_index = (2.0 + (j * 3.0))
            if ((port_get(data, base_index) == state) and (port_get(data, (base_index + 1.0)) == event_id)):
                state = port_get(data, (base_index + 2.0))
                accepted += 1.0
                break
            j += 1.0
        i += 1.0
    return [state, accepted]
