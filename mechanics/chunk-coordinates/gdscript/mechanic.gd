# Find which big map piece owns a world tile, and where that tile sits inside the piece.
# chunk-coordinates: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [world_x,world_y,chunk_size]
# Output: [chunk_x,chunk_y,local_x,local_y]
# Integer world cells; floor division ensures negative cells map correctly. Join with
# chunk*size+local.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Divide the world coordinate by the piece size and round downward.
# 2. That gives the chunk, or big piece, number.
# 3. Subtract the chunk start to get the local tile number.
# 4. Rounding downward matters: world tile -1 is in chunk -1, at the last local tile.
static func compute(data: Array) -> Array:
    var x: float = 0.0
    var y: float = 0.0
    var size: float = 0.0
    var cx: float = 0.0
    var cy: float = 0.0
    x = port_get(data, 0.0)
    y = port_get(data, 1.0)
    size = port_get(data, 2.0)
    if (size < 1.0):
        return [-(1.0)]
    cx = port_floor_num((x / size))
    cy = port_floor_num((y / size))
    return [cx, cy, (x - (cx * size)), (y - (cy * size))]
