extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)
# Remove a negative sign so a distance or size is not negative.
static func port_abs_num(a: float) -> float:
    return absf(a)

# 1. Read one direction: up, right, down, left, or no button.
# 2. Check the next square. Stay put if it is outside the map or contains a wall.
# 3. Either jump straight to that square or slide to it over the chosen step time.
# 4. Remember the newest direction briefly if it is pressed during a step. Try it after landing.
# 5. Holding a direction waits for a short delay, then requests more steps at regular times.
# Releasing stops those repeats.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var step_seconds: float = 0.0
    var repeat_delay: float = 0.0
    var repeat_interval: float = 0.0
    var buffer_seconds: float = 0.0
    var remaining: float = 0.0
    var direction: float = 0.0
    var tile_x: float = 0.0
    var tile_y: float = 0.0
    var target_x: float = 0.0
    var target_y: float = 0.0
    var progress: float = 0.0
    var buffered: float = 0.0
    var held: float = 0.0
    var repeat_remaining: float = 0.0
    var buffer_remaining: float = 0.0
    var started: float = 0.0
    var arrived: float = 0.0
    var blocked: float = 0.0
    var visual_x: float = 0.0
    var visual_y: float = 0.0
    var advance: float = 0.0
    var nx: float = 0.0
    var ny: float = 0.0
    var passable: float = 0.0
    if (port_length(data) < 18.0):
        return [-(1.0)]
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    step_seconds = port_get(data, 2.0)
    repeat_delay = port_get(data, 3.0)
    repeat_interval = port_get(data, 4.0)
    buffer_seconds = port_get(data, 5.0)
    remaining = port_get(data, 6.0)
    direction = port_get(data, 7.0)
    tile_x = port_get(data, 8.0)
    tile_y = port_get(data, 9.0)
    target_x = port_get(data, 10.0)
    target_y = port_get(data, 11.0)
    progress = port_get(data, 12.0)
    buffered = port_get(data, 13.0)
    held = port_get(data, 14.0)
    repeat_remaining = port_get(data, 15.0)
    buffer_remaining = port_get(data, 16.0)
    if ((w < 1.0) or (h < 1.0) or (port_floor_num(w) != w) or (port_floor_num(h) != h) or (port_length(data) != (17.0 + (w * h)))):
        return [-(1.0)]
    if ((step_seconds < 0.0) or (repeat_delay < 0.01) or (repeat_interval < 0.01) or (buffer_seconds < 0.0) or (remaining < 0.0) or (remaining > 1.0)):
        return [-(1.0)]
    if ((direction < 0.0) or (direction > 4.0) or (port_floor_num(direction) != direction) or (held < 0.0) or (held > 4.0) or (port_floor_num(held) != held) or (buffered < 0.0) or (buffered > 4.0) or (port_floor_num(buffered) != buffered)):
        return [-(1.0)]
    if ((tile_x < 0.0) or (tile_x >= w) or (tile_y < 0.0) or (tile_y >= h) or (target_x < 0.0) or (target_x >= w) or (target_y < 0.0) or (target_y >= h)):
        return [-(1.0)]
    if ((port_floor_num(tile_x) != tile_x) or (port_floor_num(tile_y) != tile_y) or (port_floor_num(target_x) != target_x) or (port_floor_num(target_y) != target_y)):
        return [-(1.0)]
    if ((progress < 0.0) or (progress > 1.0) or (repeat_remaining < 0.0) or (buffer_remaining < 0.0) or ((port_abs_num((target_x - tile_x)) + port_abs_num((target_y - tile_y))) > 1.0)):
        return [-(1.0)]
    if (((target_x == tile_x) and (target_y == tile_y) and (progress != 0.0)) or (port_get(data, ((17.0 + (tile_y * w)) + tile_x)) != 0.0) or (port_get(data, ((17.0 + (target_y * w)) + target_x)) != 0.0)):
        return [-(1.0)]
    # Instant mode cannot resume a previously unfinished smooth step.
    if ((step_seconds == 0.0) and ((target_x != tile_x) or (target_y != tile_y))):
        return [-(1.0)]
    # A changed direction is a fresh press; a release stops repeating but keeps a live buffer.
    if (direction != held):
        held = direction
        repeat_remaining = 0.0
        if (direction != 0.0):
            repeat_remaining = repeat_delay
            buffered = direction
            buffer_remaining = buffer_seconds
    started = 0.0
    arrived = 0.0
    blocked = 0.0
    # Process exact event boundaries so a long update does not skip repeats or overshoot tiles.
    while (1.0 == 1.0):
        if (((target_x != tile_x) or (target_y != tile_y)) and (progress >= (1.0 - 1e-09))):
            tile_x = target_x
            tile_y = target_y
            progress = 0.0
            arrived += 1.0
        if ((held != 0.0) and (repeat_remaining <= 1e-09)):
            buffered = held
            buffer_remaining = buffer_seconds
            repeat_remaining += repeat_interval
        if ((tile_x == target_x) and (tile_y == target_y) and (buffered != 0.0)):
            nx = tile_x
            ny = tile_y
            if (buffered == 1.0):
                ny -= 1.0
            if (buffered == 2.0):
                nx += 1.0
            if (buffered == 3.0):
                ny += 1.0
            if (buffered == 4.0):
                nx -= 1.0
            # Consume each request once, including a blocked request.
            buffered = 0.0
            buffer_remaining = 0.0
            passable = 0.0
            if ((nx >= 0.0) and (nx < w) and (ny >= 0.0) and (ny < h)):
                if (port_get(data, ((17.0 + (ny * w)) + nx)) == 0.0):
                    passable = 1.0
            if (passable == 0.0):
                blocked = 1.0
            else:
                target_x = nx
                target_y = ny
                started += 1.0
                if (step_seconds == 0.0):
                    tile_x = target_x
                    tile_y = target_y
                    arrived += 1.0
        if (remaining <= 1e-09):
            break
        advance = remaining
        if (held != 0.0):
            advance = port_minimum(advance, repeat_remaining)
        if ((tile_x != target_x) or (tile_y != target_y)):
            advance = port_minimum(advance, ((1.0 - progress) * step_seconds))
            progress += (advance / step_seconds)
        remaining = port_maximum(0.0, (remaining - advance))
        if (held != 0.0):
            repeat_remaining = port_maximum(0.0, (repeat_remaining - advance))
        if (buffered != 0.0):
            buffer_remaining -= advance
            # A buffer remains valid at its exact deadline, but expires strictly after it.
            if (buffer_remaining < -(1e-09)):
                buffered = 0.0
                buffer_remaining = 0.0
            else:
                buffer_remaining = port_maximum(0.0, buffer_remaining)
    visual_x = (tile_x + ((target_x - tile_x) * progress))
    visual_y = (tile_y + ((target_y - tile_y) * progress))
    return [tile_x, tile_y, target_x, target_y, progress, buffered, held, repeat_remaining, buffer_remaining, visual_x, visual_y, started, arrived, blocked]
