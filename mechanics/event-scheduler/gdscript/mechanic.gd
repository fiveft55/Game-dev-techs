# Do planned simulation jobs in time order.
# event-scheduler: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [target_time,...[event_time,event_id]]
# Output: [...due_event_ids_sorted_by_time]
# Schedule supplied as a batch; stable insertion sort preserves simultaneous event order. Unlike
# the heap-based Python service, this pure kernel has no incremental scheduling API.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Give each job a time and a job number.
# 2. Sort the jobs from early to late.
# 3. Keep original order when two jobs share the same time.
# 4. Return jobs due by the requested time. The portable kernel processes a batch rather than
# maintaining a live clock service.
static func compute(data: Array) -> Array:
    var target: float = 0.0
    var times: Array = []
    var ids: Array = []
    var i: float = 0.0
    var result: Array = []
    var at: float = 0.0
    var identifier: float = 0.0
    var position: float = 0.0
    target = port_get(data, 0.0)
    if (target < 0.0):
        return [-(1.0)]
    times = []
    ids = []
    i = 1.0
    while (i < port_length(data)):
        at = port_get(data, i)
        identifier = port_get(data, (i + 1.0))
        if (at < 0.0):
            return [-(1.0)]
        position = port_length(times)
        port_push(times, at)
        port_push(ids, identifier)
        while ((position > 0.0) and (port_get(times, (position - 1.0)) > at)):
            port_put(times, position, port_get(times, (position - 1.0)))
            port_put(ids, position, port_get(ids, (position - 1.0)))
            position -= 1.0
        port_put(times, position, at)
        port_put(ids, position, identifier)
        i += 2.0
    result = []
    i = 0.0
    while (i < port_length(times)):
        if (port_get(times, i) <= target):
            port_push(result, port_get(ids, i))
        i += 1.0
    return result
