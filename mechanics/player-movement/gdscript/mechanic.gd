# Move a player in the direction they press, without making diagonal movement faster.
# player-movement: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [x, y, input_x, input_y, speed, dt]
# Output: [new_x, new_y]
# World units and seconds. Preserve analog magnitude below one; normalize diagonal input.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)
# Find the number that multiplies by itself to make the input; useful for distance.
static func port_sqrt_num(a: float) -> float:
    return sqrt(a)

# 1. Read where the player is and which direction they want to go.
# 2. If the direction arrow is too long, shrink it to length one.
# 3. Multiply that direction by speed and the time that passed.
# 4. Add the result to the old position.
static func compute(data: Array) -> Array:
    var x: float = 0.0
    var y: float = 0.0
    var ix: float = 0.0
    var iy: float = 0.0
    var speed: float = 0.0
    var dt: float = 0.0
    var scale: float = 0.0
    x = port_get(data, 0.0)
    y = port_get(data, 1.0)
    ix = port_get(data, 2.0)
    iy = port_get(data, 3.0)
    speed = port_get(data, 4.0)
    dt = port_get(data, 5.0)
    if ((speed < 0.0) or (dt < 0.0)):
        return [-(1.0)]
    scale = port_maximum(1.0, port_sqrt_num(((ix * ix) + (iy * iy))))
    return [(x + (((ix / scale) * speed) * dt)), (y + (((iy / scale) * speed) * dt))]
