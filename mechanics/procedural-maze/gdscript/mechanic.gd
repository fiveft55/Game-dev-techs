# Build a new maze by digging paths through a wall-filled map.
# procedural-maze: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [odd_width, odd_height, uint32_seed]
# Output: [...row_major_grid]
# Iterative randomized depth-first carving. Portable LCG (not cryptographic) gives the same map
# across these six languages; it differs from Python random.Random.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Remove the last number from the list and return it.
static func port_pop_value(a: Array) -> float:
    assert(not a.is_empty(), "empty")
    return float(a.pop_back())
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Fill the map with walls and open one starting square.
# 2. Pick a nearby unopened room using a repeatable number generator.
# 3. Break the wall between the old room and the new room.
# 4. When stuck, walk back through the remembered rooms until another path can be dug.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var seed: float = 0.0
    var grid: Array = []
    var stack: Array = []
    var i: float = 0.0
    var cell: float = 0.0
    var x: float = 0.0
    var y: float = 0.0
    var options: Array = []
    var direction: float = 0.0
    var nx: float = 0.0
    var ny: float = 0.0
    var chosen: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    seed = port_get(data, 2.0)
    if ((w < 3.0) or (h < 3.0) or (port_mod_num(w, 2.0) != 1.0) or (port_mod_num(h, 2.0) != 1.0) or (seed < 0.0) or (seed >= 4294967296.0)):
        return [-(1.0)]
    grid = []
    stack = [(w + 1.0)]
    i = 0.0
    while (i < (w * h)):
        port_push(grid, 1.0)
        i += 1.0
    port_put(grid, (w + 1.0), 0.0)
    while (port_length(stack) > 0.0):
        cell = port_get(stack, (port_length(stack) - 1.0))
        x = port_mod_num(cell, w)
        y = port_floor_num((cell / w))
        options = []
        direction = 0.0
        while (direction < 4.0):
            nx = x
            ny = y
            if (direction == 0.0):
                nx += 2.0
            if (direction == 1.0):
                nx -= 2.0
            if (direction == 2.0):
                ny += 2.0
            if (direction == 3.0):
                ny -= 2.0
            if ((nx > 0.0) and (nx < (w - 1.0)) and (ny > 0.0) and (ny < (h - 1.0))):
                if (port_get(grid, ((ny * w) + nx)) == 1.0):
                    port_push(options, ((ny * w) + nx))
            direction += 1.0
        if (port_length(options) == 0.0):
            port_pop_value(stack)
        else:
            seed = port_mod_num(((seed * 1664525.0) + 1013904223.0), 4294967296.0)
            chosen = port_get(options, port_mod_num(seed, port_length(options)))
            nx = port_mod_num(chosen, w)
            ny = port_floor_num((chosen / w))
            port_put(grid, ((((y + ny) / 2.0) * w) + ((x + nx) / 2.0)), 0.0)
            port_put(grid, chosen, 0.0)
            port_push(stack, chosen)
    return grid
