# Choose which picture of an animation should be shown at a given time.
# animation-timeline: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [elapsed,loop_flag,frame_count,...durations]
# Output: [frame_index]
# Positive frame durations in seconds; exact boundaries choose the next frame. No textures,
# skeletons, blending or event dispatch.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Give every picture a positive display duration.
# 2. Add durations until reaching the requested time.
# 3. Choose the picture covering that moment.
# 4. Loop back to the beginning for repeating animation, or hold the last picture for a one-shot
# animation.
static func compute(data: Array) -> Array:
    var elapsed: float = 0.0
    var looping: float = 0.0
    var n: float = 0.0
    var total: float = 0.0
    var i: float = 0.0
    var time: float = 0.0
    var end_index: float = 0.0
    var duration: float = 0.0
    elapsed = port_get(data, 0.0)
    looping = port_get(data, 1.0)
    n = port_get(data, 2.0)
    if ((elapsed < 0.0) or (n < 1.0) or (port_length(data) != (3.0 + n))):
        return [-(1.0)]
    total = 0.0
    i = 0.0
    while (i < n):
        duration = port_get(data, (3.0 + i))
        if (duration <= 0.0):
            return [-(1.0)]
        total += duration
        i += 1.0
    if ((looping == 0.0) and (elapsed >= total)):
        return [(n - 1.0)]
    time = elapsed
    if (looping == 1.0):
        time = port_mod_num(time, total)
    end_index = 0.0
    i = 0.0
    while (i < n):
        end_index += port_get(data, (3.0 + i))
        if (time < end_index):
            return [i]
        i += 1.0
    return [(n - 1.0)]
