# Shuffle a card pile, draw cards, and reuse discarded cards when the pile runs out.
# deck-draw: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [uint32_seed,card_count,...card_ids,...operations]
# Output: [...drawn_card_ids_or_minus_one]
# Operation -1 draws; nonnegative operation discards that card. Portable LCG Fisher-Yates; only
# server-owned decks can protect hidden cards. Not cryptographic or gambling-ready.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Remove the last number from the list and return it.
static func port_pop_value(a: Array) -> float:
    assert(not a.is_empty(), "empty")
    return float(a.pop_back())
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Shuffle by swapping cards using a repeatable number generator.
# 2. Drawing removes the last card from the pile.
# 3. If the pile is empty, shuffle the discard pile into a new draw pile.
# 4. If both piles are empty, return the no-card marker. This predictable shuffle is not secure
# against cheaters.
static func compute(data: Array) -> Array:
    var seed: float = 0.0
    var n: float = 0.0
    var pile: Array = []
    var discard: Array = []
    var i: float = 0.0
    var result: Array = []
    var operation_index: float = 0.0
    var j: float = 0.0
    var swap: float = 0.0
    var operation: float = 0.0
    seed = port_get(data, 0.0)
    n = port_get(data, 1.0)
    if ((seed < 0.0) or (seed >= 4294967296.0) or (n < 0.0)):
        return [-(2.0)]
    pile = []
    discard = []
    i = 0.0
    while (i < n):
        port_push(pile, port_get(data, (2.0 + i)))
        i += 1.0
    i = (n - 1.0)
    while (i > 0.0):
        seed = port_mod_num(((seed * 1664525.0) + 1013904223.0), 4294967296.0)
        j = port_mod_num(seed, (i + 1.0))
        swap = port_get(pile, i)
        port_put(pile, i, port_get(pile, j))
        port_put(pile, j, swap)
        i -= 1.0
    result = []
    operation_index = (2.0 + n)
    while (operation_index < port_length(data)):
        operation = port_get(data, operation_index)
        if (operation >= 0.0):
            port_push(discard, operation)
        else:
            if (operation == -(1.0)):
                if (port_length(pile) == 0.0):
                    pile = discard.duplicate()
                    discard = []
                    i = (port_length(pile) - 1.0)
                    while (i > 0.0):
                        seed = port_mod_num(((seed * 1664525.0) + 1013904223.0), 4294967296.0)
                        j = port_mod_num(seed, (i + 1.0))
                        swap = port_get(pile, i)
                        port_put(pile, i, port_get(pile, j))
                        port_put(pile, j, swap)
                        i -= 1.0
                if (port_length(pile) == 0.0):
                    port_push(result, -(1.0))
                else:
                    port_push(result, port_pop_value(pile))
            else:
                return [-(2.0)]
        operation_index += 1.0
    return result
