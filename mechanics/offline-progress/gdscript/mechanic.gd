# Give an idle-game player resources for time spent away, up to a limit.
# offline-progress: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [rate,saved_at,now,cap_seconds]
# Output: [produced]
# Binary64 arithmetic in these ports, unlike Python Decimal. Use integer fixed-point/server-ledger
# arithmetic for financial/economy precision. Client clocks remain untrusted.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Subtract the last saved time from the current time.
# 2. If the clock moved backward, count zero time.
# 3. Limit the counted time so a very long absence does not give unlimited rewards.
# 4. Multiply counted seconds by production rate. Online games must use trusted time and prevent
# claiming twice.
static func compute(data: Array) -> Array:
    var rate: float = 0.0
    var saved: float = 0.0
    var now: float = 0.0
    var cap: float = 0.0
    var elapsed: float = 0.0
    rate = port_get(data, 0.0)
    saved = port_get(data, 1.0)
    now = port_get(data, 2.0)
    cap = port_get(data, 3.0)
    if ((rate < 0.0) or (cap < 0.0)):
        return [-(1.0)]
    elapsed = port_minimum(cap, port_maximum(0.0, (now - saved)))
    return [(rate * elapsed)]
