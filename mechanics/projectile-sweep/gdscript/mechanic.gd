# Check whether a fast bullet passed through a box between two updates.
# projectile-sweep: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [start_x,start_y,end_x,end_y,rect_x,rect_y,width,height]
# Output: [first_contact_fraction] or []
# Point projectile versus stationary rectangle; slab interval intersection detects tunneling.
# Inflate geometry separately for projectile volume.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Draw the entire line from the bullet old position to its new position.
# 2. Find the part of that line that is inside the box left-to-right.
# 3. Find the part that is inside the box bottom-to-top.
# 4. If those parts overlap, return the first hit point as a fraction of the move. A fraction of
# 0.4 means 40 percent along.
static func compute(data: Array) -> Array:
    var near: float = 0.0
    var far: float = 0.0
    var axis: float = 0.0
    var origin: float = 0.0
    var direction: float = 0.0
    var low: float = 0.0
    var high: float = 0.0
    var a: float = 0.0
    var b: float = 0.0
    if ((port_get(data, 6.0) < 0.0) or (port_get(data, 7.0) < 0.0)):
        return [-(1.0)]
    near = 0.0
    far = 1.0
    axis = 0.0
    while (axis < 2.0):
        origin = port_get(data, axis)
        direction = (port_get(data, (axis + 2.0)) - origin)
        low = port_get(data, (axis + 4.0))
        high = (low + port_get(data, (axis + 6.0)))
        if (direction == 0.0):
            if ((origin < low) or (origin > high)):
                return []
        else:
            a = ((low - origin) / direction)
            b = ((high - origin) / direction)
            near = port_maximum(near, port_minimum(a, b))
            far = port_minimum(far, port_maximum(a, b))
            if (near > far):
                return []
        axis += 1.0
    return [near]
