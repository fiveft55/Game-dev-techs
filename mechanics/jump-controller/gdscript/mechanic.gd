# Make jumping feel forgiving when the button press is slightly early or slightly late.
# jump-controller: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [coyote_seconds, buffer_seconds, ...[time,grounded_flag,pressed_flag]]
# Output: [...jump_flags]
# Monotonic finite timestamps. One consumed jump per grounded episode; collision reporting is the
# caller responsibility.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Remember the last time the character touched the ground.
# 2. Remember the last time the jump button was pressed.
# 3. Allow a jump if those memories are still recent enough.
# 4. Use up that jump so one press cannot keep creating jumps in mid-air. A new landing restores
# it.
static func compute(data: Array) -> Array:
    var coyote: float = 0.0
    var buffer: float = 0.0
    var last_ground: float = 0.0
    var last_press: float = 0.0
    var previous_time: float = 0.0
    var used: float = 0.0
    var was_grounded: float = 0.0
    var result: Array = []
    var i: float = 0.0
    var now: float = 0.0
    var grounded: float = 0.0
    var pressed: float = 0.0
    var jump: float = 0.0
    coyote = port_get(data, 0.0)
    buffer = port_get(data, 1.0)
    if ((coyote < 0.0) or (buffer < 0.0)):
        return [-(1.0)]
    last_ground = -(1e+30)
    last_press = -(1e+30)
    previous_time = -(1e+30)
    used = 0.0
    was_grounded = 0.0
    result = []
    i = 2.0
    while (i < port_length(data)):
        now = port_get(data, i)
        grounded = port_get(data, (i + 1.0))
        pressed = port_get(data, (i + 2.0))
        if (now < previous_time):
            return [-(1.0)]
        previous_time = now
        if (grounded == 1.0):
            if (was_grounded == 0.0):
                used = 0.0
            last_ground = now
        was_grounded = grounded
        if (pressed == 1.0):
            last_press = now
        jump = 0.0
        if ((used == 0.0) and ((now - last_ground) <= coyote) and ((now - last_press) <= buffer)):
            used = 1.0
            last_press = -(1e+30)
            jump = 1.0
        port_push(result, jump)
        i += 3.0
    return result
