# Make a ball bounce off a wall or floor.
# ball-reflection: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [vx,vy,normal_x,normal_y,restitution]
# Output: [new_vx,new_vy]
# Normalize the surface normal; reflect only approaching velocity. Restitution in [0,1], no
# friction or spin.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Find the number that multiplies by itself to make the input; useful for distance.
static func port_sqrt_num(a: float) -> float:
    return sqrt(a)

# 1. Describe which way the surface faces using a short arrow called a normal.
# 2. If the ball is already moving away, do not bounce it again.
# 3. Reverse the part of its speed going into the surface.
# 4. Use restitution, a number from zero to one, to choose how much bounce remains. Sideways
# speed stays unchanged.
static func compute(data: Array) -> Array:
    var vx: float = 0.0
    var vy: float = 0.0
    var nx: float = 0.0
    var ny: float = 0.0
    var e: float = 0.0
    var size: float = 0.0
    var incoming: float = 0.0
    var impulse: float = 0.0
    vx = port_get(data, 0.0)
    vy = port_get(data, 1.0)
    nx = port_get(data, 2.0)
    ny = port_get(data, 3.0)
    e = port_get(data, 4.0)
    size = port_sqrt_num(((nx * nx) + (ny * ny)))
    if ((size == 0.0) or (e < 0.0) or (e > 1.0)):
        return [-(1.0)]
    nx /= size
    ny /= size
    incoming = ((vx * nx) + (vy * ny))
    if (incoming >= 0.0):
        return [vx, vy]
    impulse = ((1.0 + e) * incoming)
    return [(vx - (impulse * nx)), (vy - (impulse * ny))]
