# Let the server move a player from allowed directions instead of trusting a claimed player
# position.
# server-input-validation: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [speed,server_dt,...[sequence,dx,dy]]
# Output: [x,y,last_sequence,...accepted_flags]
# Finite binary64 normalized input only, increasing integer sequence <=2^53-1. One command per
# server tick; caller must authenticate and rate-limit. No sockets, collision or encryption.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Require a newer whole-number message sequence.
# 2. Reject direction arrows longer than one.
# 3. Use server-owned speed and update time to calculate movement.
# 4. Ignore rejected commands. Network parsing, authentication, finite-number checks and one-
# command-per-tick limits belong at the server boundary.
static func compute(data: Array) -> Array:
    var speed: float = 0.0
    var dt: float = 0.0
    var x: float = 0.0
    var y: float = 0.0
    var sequence: float = 0.0
    var result: Array = []
    var i: float = 0.0
    var seq: float = 0.0
    var dx: float = 0.0
    var dy: float = 0.0
    var accepted: float = 0.0
    speed = port_get(data, 0.0)
    dt = port_get(data, 1.0)
    if ((speed < 0.0) or (dt <= 0.0)):
        return [-(1.0)]
    x = 0.0
    y = 0.0
    sequence = -(1.0)
    result = [0.0, 0.0, -(1.0)]
    i = 2.0
    while (i < port_length(data)):
        seq = port_get(data, i)
        dx = port_get(data, (i + 1.0))
        dy = port_get(data, (i + 2.0))
        accepted = 0.0
        if ((seq > sequence) and (seq <= 9007199254740991.0) and (port_floor_num(seq) == seq) and (((dx * dx) + (dy * dy)) <= 1.0)):
            x += ((dx * speed) * dt)
            y += ((dy * speed) * dt)
            sequence = seq
            accepted = 1.0
        port_push(result, accepted)
        i += 3.0
    port_put(result, 0.0, x)
    port_put(result, 1.0, y)
    port_put(result, 2.0, sequence)
    return result
