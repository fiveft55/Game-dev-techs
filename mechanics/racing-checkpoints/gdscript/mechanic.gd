# Count a racing lap only after the driver visits every checkpoint in order.
# racing-checkpoints: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [checkpoint_count,target_laps,...[enter_flag,checkpoint_id]]
# Output: [laps,next_checkpoint,finished_flag]
# Enter=1, exit=0. Enter overlap can only count once until exit. Checkpoint order is 0..count-1.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Start by expecting checkpoint zero.
# 2. Ignore a checkpoint reached out of order.
# 3. Do not count the same overlap again until the car leaves it.
# 4. After the last checkpoint, add one lap and expect checkpoint zero again.
static func compute(data: Array) -> Array:
    var n: float = 0.0
    var target: float = 0.0
    var inside: Array = []
    var i: float = 0.0
    var laps: float = 0.0
    var next_checkpoint: float = 0.0
    var finished: float = 0.0
    var entering: float = 0.0
    var checkpoint: float = 0.0
    n = port_get(data, 0.0)
    target = port_get(data, 1.0)
    if ((n < 1.0) or (target < 1.0)):
        return [-(1.0)]
    inside = []
    i = 0.0
    while (i < n):
        port_push(inside, 0.0)
        i += 1.0
    laps = 0.0
    next_checkpoint = 0.0
    i = 2.0
    while (i < port_length(data)):
        entering = port_get(data, i)
        checkpoint = port_get(data, (i + 1.0))
        if ((checkpoint < 0.0) or (checkpoint >= n)):
            return [-(1.0)]
        if (entering == 0.0):
            port_put(inside, checkpoint, 0.0)
        else:
            if (port_get(inside, checkpoint) == 0.0):
                port_put(inside, checkpoint, 1.0)
                if ((laps < target) and (checkpoint == next_checkpoint)):
                    next_checkpoint += 1.0
                    if (next_checkpoint == n):
                        laps += 1.0
                        next_checkpoint = 0.0
        i += 2.0
    finished = 0.0
    if (laps >= target):
        finished = 1.0
    return [laps, next_checkpoint, finished]
