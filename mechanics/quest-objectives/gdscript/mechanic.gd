# Track jobs such as collecting two logs and talking to one villager.
# quest-objectives: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [objective_count,...target_counts,...[objective_index,amount]]
# Output: [complete_flag,claim_flag,...progress]
# Progress clamps to target; unknown indices are ignored. One final claim per batch; persistence
# and atomic reward payout remain application concerns.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)

# 1. Give each job a target count.
# 2. Add progress when its event happens.
# 3. Stop each counter at its target; extra logs do not make the counter run forever.
# 4. The quest is complete only when every job is complete. Persistent reward claiming needs
# extra storage rules.
static func compute(data: Array) -> Array:
    var n: float = 0.0
    var progress: Array = []
    var i: float = 0.0
    var complete: float = 0.0
    var result: Array = []
    var index: float = 0.0
    var amount: float = 0.0
    n = port_get(data, 0.0)
    if ((n < 1.0) or (port_length(data) < (1.0 + n))):
        return [-(1.0)]
    progress = []
    i = 0.0
    while (i < n):
        if (port_get(data, (1.0 + i)) <= 0.0):
            return [-(1.0)]
        port_push(progress, 0.0)
        i += 1.0
    i = (1.0 + n)
    while (i < port_length(data)):
        index = port_get(data, i)
        amount = port_get(data, (i + 1.0))
        if (amount < 0.0):
            return [-(1.0)]
        if ((index >= 0.0) and (index < n)):
            port_put(progress, index, port_minimum(port_get(data, (1.0 + index)), (port_get(progress, index) + amount)))
        i += 2.0
    complete = 1.0
    i = 0.0
    while (i < n):
        if (port_get(progress, i) < port_get(data, (1.0 + i))):
            complete = 0.0
        i += 1.0
    result = [complete, complete]
    i = 0.0
    while (i < n):
        port_push(result, port_get(progress, i))
        i += 1.0
    return result
