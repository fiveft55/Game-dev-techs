# Turn ingredients into products, such as two pieces of wood becoming three planks.
# crafting-recipes: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [resource_count,batches,...inventory,...ingredient_counts,...product_counts]
# Output: [success_flag,...result_inventory]
# Fixed resource indices and nonnegative counts. At least one input and output; positive batches.
# Products cannot fund their own inputs. No inventory capacity/station constraints.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Multiply ingredient and product counts by the number of batches.
# 2. Check that the backpack has every ingredient.
# 3. If anything is missing, change nothing.
# 4. Otherwise take the ingredients first, then add the products. Products cannot pay for their
# own ingredients.
static func compute(data: Array) -> Array:
    var n: float = 0.0
    var batches: float = 0.0
    var success: float = 0.0
    var inputs: float = 0.0
    var outputs: float = 0.0
    var i: float = 0.0
    var result: Array = []
    var inventory: float = 0.0
    var cost: float = 0.0
    var product: float = 0.0
    var value: float = 0.0
    n = port_get(data, 0.0)
    batches = port_get(data, 1.0)
    if ((n < 1.0) or (batches < 1.0) or (port_length(data) != (2.0 + (3.0 * n)))):
        return [-(1.0)]
    success = 1.0
    inputs = 0.0
    outputs = 0.0
    i = 0.0
    while (i < n):
        inventory = port_get(data, (2.0 + i))
        cost = port_get(data, ((2.0 + n) + i))
        product = port_get(data, ((2.0 + (2.0 * n)) + i))
        if ((inventory < 0.0) or (cost < 0.0) or (product < 0.0)):
            return [-(1.0)]
        inputs += cost
        outputs += product
        if (inventory < (cost * batches)):
            success = 0.0
        i += 1.0
    if ((inputs == 0.0) or (outputs == 0.0)):
        return [-(1.0)]
    result = [success]
    i = 0.0
    while (i < n):
        value = port_get(data, (2.0 + i))
        if (success == 1.0):
            value += ((port_get(data, ((2.0 + (2.0 * n)) + i)) - port_get(data, ((2.0 + n) + i))) * batches)
        port_push(result, value)
        i += 1.0
    return result
