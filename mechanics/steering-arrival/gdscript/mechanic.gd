# Make an enemy or vehicle slow down as it reaches its target.
# steering-arrival: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [x, y, target_x, target_y, max_speed, slowing_radius]
# Output: [desired_vx, desired_vy]
# Desired velocity only; acceleration limits belong to a separate controller.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Find the number that multiplies by itself to make the input; useful for distance.
static func port_sqrt_num(a: float) -> float:
    return sqrt(a)

# 1. Draw an arrow from the object to the target.
# 2. Measure how far away the target is.
# 3. Far away means full speed. Nearby means a smaller speed.
# 4. Return the wanted speed in each direction; another controller must actually apply it.
static func compute(data: Array) -> Array:
    var dx: float = 0.0
    var dy: float = 0.0
    var speed: float = 0.0
    var radius: float = 0.0
    var distance: float = 0.0
    var scaled: float = 0.0
    dx = (port_get(data, 2.0) - port_get(data, 0.0))
    dy = (port_get(data, 3.0) - port_get(data, 1.0))
    speed = port_get(data, 4.0)
    radius = port_get(data, 5.0)
    if ((speed < 0.0) or (radius <= 0.0)):
        return [-(1.0)]
    distance = port_sqrt_num(((dx * dx) + (dy * dy)))
    if (distance == 0.0):
        return [0.0, 0.0]
    scaled = ((speed * port_minimum(1.0, (distance / radius))) / distance)
    return [(dx * scaled), (dy * scaled)]
