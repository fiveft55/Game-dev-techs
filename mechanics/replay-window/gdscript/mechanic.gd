# Reject a repeated or very old network message while still allowing slightly late messages.
# replay-window: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [window_width, ...authenticated_sequence_numbers]
# Output: [...accepted_flags]
# One session per call. Explicit bounded seen-list avoids language-specific 64-bit bitmask
# behavior. Sequence numbers must be integers within the safe integer range. Authenticate before
# updating state.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Each message carries a counting number.
# 2. Remember recently accepted numbers and the biggest number seen.
# 3. Reject numbers already remembered or too far behind the biggest number.
# 4. Only do this AFTER the network security layer proves the message is genuine. This code does
# not encrypt anything.
static func compute(data: Array) -> Array:
    var width: float = 0.0
    var highest: float = 0.0
    var seen: Array = []
    var result: Array = []
    var i: float = 0.0
    var seq: float = 0.0
    var accept: float = 0.0
    var j: float = 0.0
    var kept: Array = []
    width = port_get(data, 0.0)
    if (width < 1.0):
        return [-(1.0)]
    highest = -(1.0)
    seen = []
    result = []
    i = 1.0
    while (i < port_length(data)):
        seq = port_get(data, i)
        accept = 1.0
        if ((seq < 0.0) or (port_floor_num(seq) != seq) or (seq > 9007199254740991.0)):
            accept = 0.0
        if (seq <= (highest - width)):
            accept = 0.0
        j = 0.0
        while (j < port_length(seen)):
            if (port_get(seen, j) == seq):
                accept = 0.0
            j += 1.0
        if (accept == 1.0):
            highest = port_maximum(highest, seq)
            kept = []
            j = 0.0
            while (j < port_length(seen)):
                if (port_get(seen, j) > (highest - width)):
                    port_push(kept, port_get(seen, j))
                j += 1.0
            port_push(kept, seq)
            seen = kept.duplicate()
        port_push(result, accept)
        i += 1.0
    return result
