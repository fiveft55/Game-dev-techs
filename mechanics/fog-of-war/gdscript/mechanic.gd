# Hide unexplored parts of a map while remembering places the player has already seen.
# fog-of-war: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width,height,radius,observer_count,...[x,y],...previous_explored_flags]
# Output: [...visible_flags,...explored_flags]
# Radius-only 2D visibility bookkeeping; these portable kernels do not embed a caller line-of-
# sight callback. Compose visibility masks separately for walls.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Find tiles close enough to each observer.
# 2. Mark those tiles visible right now.
# 3. Keep old explored marks even when the observer moves away.
# 4. The portable version checks distance only; add wall blocking separately.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var radius: float = 0.0
    var n: float = 0.0
    var offset: float = 0.0
    var visible: Array = []
    var explored: Array = []
    var y: float = 0.0
    var i: float = 0.0
    var x: float = 0.0
    var seen: float = 0.0
    var dx: float = 0.0
    var dy: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    radius = port_get(data, 2.0)
    n = port_get(data, 3.0)
    offset = (4.0 + (2.0 * n))
    if ((w < 1.0) or (h < 1.0) or (radius < 0.0) or (n < 0.0) or (port_length(data) != (offset + (w * h)))):
        return [-(1.0)]
    visible = []
    explored = []
    y = 0.0
    while (y < h):
        x = 0.0
        while (x < w):
            seen = 0.0
            i = 0.0
            while (i < n):
                dx = (x - port_get(data, (4.0 + (2.0 * i))))
                dy = (y - port_get(data, (5.0 + (2.0 * i))))
                if (((dx * dx) + (dy * dy)) <= (radius * radius)):
                    seen = 1.0
                i += 1.0
            port_push(visible, seen)
            port_push(explored, port_maximum(seen, port_get(data, ((offset + (y * w)) + x))))
            x += 1.0
        y += 1.0
    i = 0.0
    while (i < port_length(explored)):
        port_push(visible, port_get(explored, i))
        i += 1.0
    return visible
