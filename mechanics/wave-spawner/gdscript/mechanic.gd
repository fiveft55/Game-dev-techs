# Release enemies at planned times without accidentally releasing them twice.
# wave-spawner: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [spawn_count,...[time,id],...monotonic_update_times]
# Output: [...spawned_ids]
# Input schedule must already be sorted; simultaneous events preserve input order. All due events
# emitted once even after long frames.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Keep a time-ordered list of enemies to create.
# 2. On each update, compare the game clock with the next enemy time.
# 3. Release every enemy whose time has arrived, including several after a slow frame.
# 4. Move the list cursor forward so released enemies are not repeated.
static func compute(data: Array) -> Array:
    var n: float = 0.0
    var last: float = 0.0
    var i: float = 0.0
    var index: float = 0.0
    var result: Array = []
    var at: float = 0.0
    var now: float = 0.0
    n = port_get(data, 0.0)
    if ((n < 0.0) or (port_length(data) < (1.0 + (2.0 * n)))):
        return [-(1.0)]
    last = 0.0
    i = 0.0
    while (i < n):
        at = port_get(data, (1.0 + (2.0 * i)))
        if (at < last):
            return [-(1.0)]
        last = at
        i += 1.0
    index = 0.0
    last = 0.0
    result = []
    i = (1.0 + (2.0 * n))
    while (i < port_length(data)):
        now = port_get(data, i)
        if (now < last):
            return [-(1.0)]
        last = now
        while ((index < n) and (port_get(data, (1.0 + (2.0 * index))) <= now)):
            port_push(result, port_get(data, (2.0 + (2.0 * index))))
            index += 1.0
        i += 1.0
    return result
