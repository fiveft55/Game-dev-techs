# Place a building footprint on a tile map only if every required square is free.
# building-placement: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input:
# [width,height,anchor_x,anchor_y,quarter_turns,footprint_count,...[dx,dy],...occupied_grid]
# Output: [...new_occupied_grid] or [-1]
# Counterclockwise quarter turns in Y-up coordinates. Integer footprint offsets; out-of-
# bounds/occupied cells reject the whole placement before mutation.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Rotate the footprint by the requested number of quarter turns.
# 2. Move it to the chosen anchor tile.
# 3. Check that every square is inside the map and unoccupied.
# 4. If any square fails, place nothing. Otherwise mark all footprint squares occupied together.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var ax: float = 0.0
    var ay: float = 0.0
    var turns: float = 0.0
    var n: float = 0.0
    var offset: float = 0.0
    var placements: Array = []
    var i: float = 0.0
    var result: Array = []
    var x: float = 0.0
    var y: float = 0.0
    var j: float = 0.0
    var cell: float = 0.0
    var previous_x: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    ax = port_get(data, 2.0)
    ay = port_get(data, 3.0)
    turns = port_mod_num((port_mod_num(port_get(data, 4.0), 4.0) + 4.0), 4.0)
    n = port_get(data, 5.0)
    offset = (6.0 + (2.0 * n))
    if ((w < 1.0) or (h < 1.0) or (n < 1.0) or (port_length(data) != (offset + (w * h)))):
        return [-(1.0)]
    placements = []
    i = 0.0
    while (i < n):
        x = port_get(data, (6.0 + (2.0 * i)))
        y = port_get(data, (7.0 + (2.0 * i)))
        j = 0.0
        while (j < turns):
            previous_x = x
            x = -(y)
            y = previous_x
            j += 1.0
        x += ax
        y += ay
        if ((x < 0.0) or (x >= w) or (y < 0.0) or (y >= h)):
            return [-(1.0)]
        cell = ((y * w) + x)
        if (port_get(data, (offset + cell)) != 0.0):
            return [-(1.0)]
        port_push(placements, cell)
        i += 1.0
    result = []
    i = 0.0
    while (i < (w * h)):
        port_push(result, port_get(data, (offset + i)))
        i += 1.0
    i = 0.0
    while (i < port_length(placements)):
        port_put(result, port_get(placements, i), 1.0)
        i += 1.0
    return result
