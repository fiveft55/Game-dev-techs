# Tell whether two upright rectangular boxes touch or overlap.
# aabb-collision: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [ax, ay, aw, ah, bx, by, bw, bh]
# Output: [contact: 0 or 1]
# Touching edges count as contact. Negative dimensions return [-1].
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])

# 1. Look at the left and right edges of both boxes.
# 2. Look at the top and bottom edges too.
# 3. If there is a gap on either side-to-side or up-and-down check, they do not touch.
# 4. Return one for touching and zero for separate. Touching edges count.
static func compute(data: Array) -> Array:
    var ax: float = 0.0
    var ay: float = 0.0
    var aw: float = 0.0
    var ah: float = 0.0
    var bx: float = 0.0
    var by: float = 0.0
    var bw: float = 0.0
    var bh: float = 0.0
    ax = port_get(data, 0.0)
    ay = port_get(data, 1.0)
    aw = port_get(data, 2.0)
    ah = port_get(data, 3.0)
    bx = port_get(data, 4.0)
    by = port_get(data, 5.0)
    bw = port_get(data, 6.0)
    bh = port_get(data, 7.0)
    if ((aw < 0.0) or (ah < 0.0) or (bw < 0.0) or (bh < 0.0)):
        return [-(1.0)]
    if ((ax <= (bx + bw)) and (bx <= (ax + aw)) and (ay <= (by + bh)) and (by <= (ay + ah))):
        return [1.0]
    return [0.0]
