# Send a player only nearby objects they are allowed to know about.
# interest-management: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [observer_x,observer_y,radius,...[id,x,y,allowed_flag]]
# Output: [...authorized_nearby_ids_sorted]
# Authorization must be decided by trusted server code. Nearby alone never grants access; no
# transport or field-level serializer included.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. The trusted server decides which objects this player may see.
# 2. Check how far each allowed object is from the player.
# 3. Keep only the ones inside the chosen range.
# 4. Return their IDs. This does not encrypt data or decide authorization by itself.
static func compute(data: Array) -> Array:
    var ox: float = 0.0
    var oy: float = 0.0
    var radius: float = 0.0
    var result: Array = []
    var i: float = 0.0
    var dx: float = 0.0
    var dy: float = 0.0
    var identifier: float = 0.0
    var position: float = 0.0
    ox = port_get(data, 0.0)
    oy = port_get(data, 1.0)
    radius = port_get(data, 2.0)
    if (radius < 0.0):
        return [-(1.0)]
    result = []
    i = 3.0
    while (i < port_length(data)):
        dx = (port_get(data, (i + 1.0)) - ox)
        dy = (port_get(data, (i + 2.0)) - oy)
        if ((port_get(data, (i + 3.0)) == 1.0) and (((dx * dx) + (dy * dy)) <= (radius * radius))):
            identifier = port_get(data, i)
            position = port_length(result)
            port_push(result, identifier)
            while ((position > 0.0) and (port_get(result, (position - 1.0)) > identifier)):
                port_put(result, position, port_get(result, (position - 1.0)))
                position -= 1.0
            port_put(result, position, identifier)
        i += 4.0
    return result
