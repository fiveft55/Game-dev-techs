# Update a moving point when a force-like acceleration, such as gravity, changes its speed.
# rigid-body-integration: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [x, y, vx, vy, ax, ay, dt]
# Output: [x, y, vx, vy]
# 2D semi-implicit Euler point mass. Seconds and consistent world units; no contacts.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])

# 1. Start with position and speed in each direction.
# 2. Acceleration changes speed during the time step.
# 3. Use the new speed to change position.
# 4. This moves a point; it does not stop that point from falling through floors.
static func compute(data: Array) -> Array:
    var x: float = 0.0
    var y: float = 0.0
    var vx: float = 0.0
    var vy: float = 0.0
    var ax: float = 0.0
    var ay: float = 0.0
    var dt: float = 0.0
    x = port_get(data, 0.0)
    y = port_get(data, 1.0)
    vx = port_get(data, 2.0)
    vy = port_get(data, 3.0)
    ax = port_get(data, 4.0)
    ay = port_get(data, 5.0)
    dt = port_get(data, 6.0)
    if (dt < 0.0):
        return [-(1.0)]
    vx += (ax * dt)
    vy += (ay * dt)
    return [(x + (vx * dt)), (y + (vy * dt)), vx, vy]
