# Stop an ability from being used again until a charge has recovered.
# ability-cooldown: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [charge_count,duration,...attempt_times]
# Output: [...accepted_flags]
# Each spent charge has its own parallel refill timer. Attempt times must be nonnegative and
# monotonic; equality at expiry permits reuse.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Each use spends one available charge.
# 2. Remember the time when that charge will return.
# 3. Before the next attempt, restore charges whose waiting time has ended.
# 4. Allow the attempt only if at least one charge is available. Each charge waits
# independently.
static func compute(data: Array) -> Array:
    var capacity: float = 0.0
    var duration: float = 0.0
    var pending: Array = []
    var last: float = 0.0
    var result: Array = []
    var i: float = 0.0
    var now: float = 0.0
    var kept: Array = []
    var j: float = 0.0
    var accepted: float = 0.0
    capacity = port_get(data, 0.0)
    duration = port_get(data, 1.0)
    if ((capacity < 1.0) or (duration <= 0.0)):
        return [-(1.0)]
    pending = []
    last = 0.0
    result = []
    i = 2.0
    while (i < port_length(data)):
        now = port_get(data, i)
        if (now < last):
            return [-(1.0)]
        last = now
        kept = []
        j = 0.0
        while (j < port_length(pending)):
            if (port_get(pending, j) > now):
                port_push(kept, port_get(pending, j))
            j += 1.0
        pending = kept.duplicate()
        accepted = 0.0
        if (port_length(pending) < capacity):
            port_push(pending, (now + duration))
            accepted = 1.0
        port_push(result, accepted)
        i += 1.0
    return result
