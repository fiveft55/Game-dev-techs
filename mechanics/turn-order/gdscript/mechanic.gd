# Decide whose turn comes next and remove characters who leave the fight.
# turn-order: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [actor_count,...[id,initiative],...commands]
# Output: [current_id_or_minus_one,...remaining_order]
# Numeric unique actor IDs >=0. Command -1 advances; a nonnegative command removes that actor.
# Higher initiative first, lower ID breaks ties.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Put faster characters first.
# 2. If speeds tie, use the smaller character number first so the result is repeatable.
# 3. Advance to the next character and wrap around at the end.
# 4. When someone leaves, keep the right next character rather than accidentally skipping them.
static func compute(data: Array) -> Array:
    var n: float = 0.0
    var order: Array = []
    var scores: Array = []
    var i: float = 0.0
    var index: float = 0.0
    var current: float = 0.0
    var result: Array = []
    var identifier: float = 0.0
    var score: float = 0.0
    var position: float = 0.0
    var command: float = 0.0
    var previous_score: float = 0.0
    var previous_id: float = 0.0
    var kept: Array = []
    var j: float = 0.0
    n = port_get(data, 0.0)
    if (n < 1.0):
        return [-(1.0)]
    order = []
    scores = []
    i = 0.0
    while (i < n):
        identifier = port_get(data, (1.0 + (i * 2.0)))
        score = port_get(data, (2.0 + (i * 2.0)))
        position = port_length(order)
        port_push(order, identifier)
        port_push(scores, score)
        while (position > 0.0):
            previous_score = port_get(scores, (position - 1.0))
            previous_id = port_get(order, (position - 1.0))
            if ((previous_score > score) or ((previous_score == score) and (previous_id < identifier))):
                break
            port_put(scores, position, previous_score)
            port_put(order, position, previous_id)
            position -= 1.0
        port_put(order, position, identifier)
        port_put(scores, position, score)
        i += 1.0
    index = 0.0
    i = (1.0 + (n * 2.0))
    while (i < port_length(data)):
        command = port_get(data, i)
        if (port_length(order) > 0.0):
            if (command == -(1.0)):
                index = port_mod_num((index + 1.0), port_length(order))
            else:
                kept = []
                j = 0.0
                while (j < port_length(order)):
                    if (port_get(order, j) == command):
                        if (j < index):
                            index -= 1.0
                    else:
                        port_push(kept, port_get(order, j))
                    j += 1.0
                order = kept.duplicate()
                if (port_length(order) > 0.0):
                    index = port_mod_num(index, port_length(order))
                else:
                    index = 0.0
        i += 1.0
    current = -(1.0)
    if (port_length(order) > 0.0):
        current = port_get(order, index)
    result = [current]
    i = 0.0
    while (i < port_length(order)):
        port_push(result, port_get(order, i))
        i += 1.0
    return result
