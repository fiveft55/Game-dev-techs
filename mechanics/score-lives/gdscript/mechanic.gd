# Count points, award extra lives, and remove a life after a mistake.
# score-lives: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [initial_lives, threshold, ...score_awards_or_minus_one_for_death]
# Output: [points, lives]
# Integer nonnegative awards; -1 loses a life. Large awards can cross several extra-life
# thresholds.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Add each points award to the total.
# 2. Count how many extra-life marks the score crossed.
# 3. Give one life for each mark crossed, even if one big award crosses several.
# 4. A death removes one life, but lives never go below zero.
static func compute(data: Array) -> Array:
    var lives: float = 0.0
    var threshold: float = 0.0
    var points: float = 0.0
    var i: float = 0.0
    var award: float = 0.0
    var before: float = 0.0
    lives = port_get(data, 0.0)
    threshold = port_get(data, 1.0)
    if ((lives < 0.0) or (threshold <= 0.0)):
        return [-(1.0)]
    points = 0.0
    i = 2.0
    while (i < port_length(data)):
        award = port_get(data, i)
        if (award == -(1.0)):
            lives = port_maximum(0.0, (lives - 1.0))
        else:
            if (award >= 0.0):
                before = port_floor_num((points / threshold))
                points += award
                lives += (port_floor_num((points / threshold)) - before)
            else:
                return [-(1.0)]
        i += 1.0
    return [points, lives]
