# Tell whether a music-game button press was close enough to a note time.
# rhythm-judgement: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [note_time,perfect_window,good_window,latency,...recorded_press_times]
# Output: [judgement_code]
# 0 unhit, 1 perfect, 2 good. First in-window press consumes note; no expiry operation here (apply
# miss on audio-clock expiry in the caller).
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Remove a negative sign so a distance or size is not negative.
static func port_abs_num(a: float) -> float:
    return absf(a)

# 1. Correct the recorded press time for measured input delay.
# 2. Compare it with the planned note time.
# 3. A very small gap means perfect; a larger allowed gap means good.
# 4. Ignore presses too far away. A separate audio-clock rule must mark notes missed after their
# deadline.
static func compute(data: Array) -> Array:
    var at: float = 0.0
    var perfect: float = 0.0
    var good: float = 0.0
    var latency: float = 0.0
    var i: float = 0.0
    var error: float = 0.0
    at = port_get(data, 0.0)
    perfect = port_get(data, 1.0)
    good = port_get(data, 2.0)
    latency = port_get(data, 3.0)
    if ((perfect < 0.0) or (good < perfect)):
        return [-(1.0)]
    i = 4.0
    while (i < port_length(data)):
        error = port_abs_num(((port_get(data, i) - latency) - at))
        if (error <= perfect):
            return [1.0]
        if (error <= good):
            return [2.0]
        i += 1.0
    return [0.0]
