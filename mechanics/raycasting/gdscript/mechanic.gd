# Send an invisible straight line through a tile map and report the first wall it hits.
# raycasting: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width, height, ox, oy, dx, dy, limit, ...grid]
# Output: [cell_x, cell_y, ray_parameter] or []
# Grid DDA; Y wins corner ties. Direction need not have unit length. Solid tiles are nonzero.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)
# Remove a negative sign so a distance or size is not negative.
static func port_abs_num(a: float) -> float:
    return absf(a)

# 1. Start the line at a position and choose its direction.
# 2. Calculate which tile edge the line will cross next.
# 3. Move into that next tile and check whether it is a wall.
# 4. Stop at a wall, the map edge, or the step limit. The returned time-like number tells how
# far along the line the hit occurred.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var ox: float = 0.0
    var oy: float = 0.0
    var dx: float = 0.0
    var dy: float = 0.0
    var limit: float = 0.0
    var x: float = 0.0
    var y: float = 0.0
    var sx: float = 0.0
    var sy: float = 0.0
    var tx: float = 0.0
    var ty: float = 0.0
    var stepx: float = 0.0
    var stepy: float = 0.0
    var t: float = 0.0
    var i: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    ox = port_get(data, 2.0)
    oy = port_get(data, 3.0)
    dx = port_get(data, 4.0)
    dy = port_get(data, 5.0)
    limit = port_get(data, 6.0)
    if ((w < 1.0) or (h < 1.0) or (port_length(data) != (7.0 + (w * h))) or ((dx == 0.0) and (dy == 0.0))):
        return []
    x = port_floor_num(ox)
    y = port_floor_num(oy)
    sx = -(1.0)
    sy = -(1.0)
    if (dx > 0.0):
        sx = 1.0
    if (dy > 0.0):
        sy = 1.0
    # A large sentinel replaces infinity for this bounded educational ray.
    tx = 1e+30
    ty = 1e+30
    stepx = 1e+30
    stepy = 1e+30
    if (dx != 0.0):
        tx = ((x - ox) / dx)
        if (dx > 0.0):
            tx = (((x + 1.0) - ox) / dx)
        stepx = port_abs_num((1.0 / dx))
    if (dy != 0.0):
        ty = ((y - oy) / dy)
        if (dy > 0.0):
            ty = (((y + 1.0) - oy) / dy)
        stepy = port_abs_num((1.0 / dy))
    t = 0.0
    i = 0.0
    while (i < limit):
        if ((x < 0.0) or (x >= w) or (y < 0.0) or (y >= h)):
            return []
        if (port_get(data, ((7.0 + (y * w)) + x)) != 0.0):
            return [x, y, t]
        if (tx < ty):
            t = tx
            tx += stepx
            x += sx
        else:
            t = ty
            ty += stepy
            y += sy
        i += 1.0
    return []
