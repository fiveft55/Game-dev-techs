# Draw a tiny world using keyboard characters instead of pictures.
# ascii-world: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width, height, player_cell_or_minus_one, ...grid]
# Output: [...ASCII_character_codes]
# Zero tiles render dot (46); one tiles render # (35); player renders @ (64); newline is 10.
# Decode codes with your engine UI.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Read the map one row at a time.
# 2. Turn a floor tile into a dot and a wall tile into a hash sign.
# 3. Put an at sign where the player stands.
# 4. Put a new line between rows. The native ports return character numbers: 46 is dot, 35 is
# hash, and 64 is at sign.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var player: float = 0.0
    var result: Array = []
    var y: float = 0.0
    var x: float = 0.0
    var cell: float = 0.0
    var tile: float = 0.0
    var symbol: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    player = port_get(data, 2.0)
    if ((w < 1.0) or (h < 1.0) or (port_length(data) != (3.0 + (w * h)))):
        return [-(1.0)]
    result = []
    y = 0.0
    while (y < h):
        x = 0.0
        while (x < w):
            cell = ((y * w) + x)
            tile = port_get(data, (3.0 + cell))
            if ((tile != 0.0) and (tile != 1.0)):
                return [-(1.0)]
            symbol = 46.0
            if (tile == 1.0):
                symbol = 35.0
            if (cell == player):
                symbol = 64.0
            port_push(result, symbol)
            x += 1.0
        if (y < (h - 1.0)):
            port_push(result, 10.0)
        y += 1.0
    return result
