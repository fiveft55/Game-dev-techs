# Turn experience points into a level and calculate a very simple damage amount.
# rpg-progression: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [xp, attack, armor, ...strictly_increasing_level_thresholds]
# Output: [level, damage]
# Thresholds begin at zero. Integer experience; damage is clamped attack minus armor.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Store the experience amount needed to start each level.
# 2. Count how many level marks the player has reached.
# 3. Subtract armor from attack power to get damage.
# 4. Never let damage fall below zero. You can replace this simple rule with your own balance
# formula.
static func compute(data: Array) -> Array:
    var xp: float = 0.0
    var attack: float = 0.0
    var armor: float = 0.0
    var level: float = 0.0
    var last: float = 0.0
    var i: float = 0.0
    var threshold: float = 0.0
    xp = port_get(data, 0.0)
    attack = port_get(data, 1.0)
    armor = port_get(data, 2.0)
    if ((xp < 0.0) or (attack < 0.0) or (armor < 0.0) or (port_length(data) < 4.0) or (port_get(data, 3.0) != 0.0)):
        return [-(1.0)]
    level = 0.0
    last = -(1.0)
    i = 3.0
    while (i < port_length(data)):
        threshold = port_get(data, i)
        if (threshold <= last):
            return [-(1.0)]
        last = threshold
        if (xp >= threshold):
            level += 1.0
        i += 1.0
    return [level, port_maximum(0.0, (attack - armor))]
