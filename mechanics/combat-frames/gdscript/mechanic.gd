# Split an attack into wind-up, dangerous time, and recovery time.
# combat-frames: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [startup,active,recovery,...[frame,target_id,overlap_flag]]
# Output: [...hit_flags]
# At most one hit per numeric target ID per attack. Inputs use simulation frames; hitbox geometry
# is supplied by the caller.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. During wind-up the attack is not ready to hurt anyone.
# 2. During active frames an overlapping target may be hit.
# 3. Remember each target already hit so one swing does not hit it every update.
# 4. During recovery or after the attack, do not accept new hits.
static func compute(data: Array) -> Array:
    var startup: float = 0.0
    var active: float = 0.0
    var recovery: float = 0.0
    var hit: Array = []
    var result: Array = []
    var i: float = 0.0
    var frame: float = 0.0
    var target: float = 0.0
    var overlap: float = 0.0
    var accepted: float = 0.0
    var j: float = 0.0
    startup = port_get(data, 0.0)
    active = port_get(data, 1.0)
    recovery = port_get(data, 2.0)
    if ((startup < 0.0) or (active <= 0.0) or (recovery < 0.0)):
        return [-(1.0)]
    hit = []
    result = []
    i = 3.0
    while (i < port_length(data)):
        frame = port_get(data, i)
        target = port_get(data, (i + 1.0))
        overlap = port_get(data, (i + 2.0))
        accepted = 0.0
        if ((frame >= startup) and (frame < (startup + active)) and (overlap == 1.0)):
            accepted = 1.0
            j = 0.0
            while (j < port_length(hit)):
                if (port_get(hit, j) == target):
                    accepted = 0.0
                j += 1.0
        if (accepted == 1.0):
            port_push(hit, target)
        port_push(result, accepted)
        i += 3.0
    return result
