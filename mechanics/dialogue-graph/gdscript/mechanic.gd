# Choose which conversation options are allowed and where the conversation goes next.
# dialogue-graph: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [initial_node,initial_flag_mask,choice_count,...[from,event,to,requires_mask,grant_mask],
# ...events]
# Output: [final_node,flag_mask,accepted_choices]
# Numeric node/event IDs; flags use bit values 1,2,4,... up to 2^30. Event IDs select choices
# rather than UI list indices; first available match wins. Text/localization is separate.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Keep the current conversation node and simple yes-or-no story flags.
# 2. Look for the chosen event among options leaving that node.
# 3. Require the necessary flags before allowing the choice.
# 4. Grant new flags and move to the next node. Flag values 1, 2, and 4 are separate switches;
# adding them can store several switches together.
static func compute(data: Array) -> Array:
    var node: float = 0.0
    var flags: float = 0.0
    var n: float = 0.0
    var accepted: float = 0.0
    var i: float = 0.0
    var event_id: float = 0.0
    var j: float = 0.0
    var base_index: float = 0.0
    var requires: float = 0.0
    var allowed: float = 0.0
    var power: float = 0.0
    var grants: float = 0.0
    node = port_get(data, 0.0)
    flags = port_get(data, 1.0)
    n = port_get(data, 2.0)
    accepted = 0.0
    i = (3.0 + (n * 5.0))
    while (i < port_length(data)):
        event_id = port_get(data, i)
        j = 0.0
        while (j < n):
            base_index = (3.0 + (j * 5.0))
            if ((port_get(data, base_index) == node) and (port_get(data, (base_index + 1.0)) == event_id)):
                requires = port_get(data, (base_index + 3.0))
                allowed = 1.0
                power = 1.0
                while (power <= requires):
                    if ((port_mod_num(port_floor_num((requires / power)), 2.0) == 1.0) and (port_mod_num(port_floor_num((flags / power)), 2.0) == 0.0)):
                        allowed = 0.0
                    power *= 2.0
                if (allowed == 1.0):
                    grants = port_get(data, (base_index + 4.0))
                    power = 1.0
                    while (power <= grants):
                        if ((port_mod_num(port_floor_num((grants / power)), 2.0) == 1.0) and (port_mod_num(port_floor_num((flags / power)), 2.0) == 0.0)):
                            flags += power
                        power *= 2.0
                    node = port_get(data, (base_index + 2.0))
                    accepted += 1.0
                    break
            j += 1.0
        i += 1.0
    return [node, flags, accepted]
