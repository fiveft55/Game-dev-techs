# Remove matching rows or columns of tiles, then let the remaining tiles fall down.
# match-grid: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width,height,minimum_run,...tiles]
# Output: [matched_count,...collapsed_tiles]
# Tile -1 is empty. Detect horizontal/vertical matches, merge intersections, then apply column
# gravity. No random refill or cascade.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Find long enough runs of identical nonempty tiles.
# 2. Mark each matching tile once, even where a row and column cross.
# 3. Remove all marked tiles together.
# 4. Slide surviving tiles to the bottom of each column without changing their order.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var minimum_run: float = 0.0
    var matched: Array = []
    var i: float = 0.0
    var axis: float = 0.0
    var count: float = 0.0
    var grid: Array = []
    var x: float = 0.0
    var result: Array = []
    var lines: float = 0.0
    var span: float = 0.0
    var line: float = 0.0
    var bottom: float = 0.0
    var y: float = 0.0
    var start: float = 0.0
    var cell: float = 0.0
    var stride: float = 0.0
    var tile: float = 0.0
    var end_index: float = 0.0
    var j: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    minimum_run = port_get(data, 2.0)
    if ((w < 1.0) or (h < 1.0) or (minimum_run < 2.0) or (port_length(data) != (3.0 + (w * h)))):
        return [-(1.0)]
    matched = []
    i = 0.0
    while (i < (w * h)):
        port_push(matched, 0.0)
        i += 1.0
    axis = 0.0
    while (axis < 2.0):
        lines = h
        span = w
        if (axis == 1.0):
            lines = w
            span = h
        line = 0.0
        while (line < lines):
            start = 0.0
            while (start < span):
                cell = ((line * w) + start)
                stride = 1.0
                if (axis == 1.0):
                    cell = ((start * w) + line)
                    stride = w
                tile = port_get(data, (3.0 + cell))
                end_index = (start + 1.0)
                while ((end_index < span) and (port_get(data, ((3.0 + cell) + ((end_index - start) * stride))) == tile)):
                    end_index += 1.0
                if ((tile != -(1.0)) and ((end_index - start) >= minimum_run)):
                    j = start
                    while (j < end_index):
                        port_put(matched, (cell + ((j - start) * stride)), 1.0)
                        j += 1.0
                start = end_index
            line += 1.0
        axis += 1.0
    count = 0.0
    grid = []
    i = 0.0
    while (i < (w * h)):
        count += port_get(matched, i)
        port_push(grid, -(1.0))
        i += 1.0
    x = 0.0
    while (x < w):
        bottom = (h - 1.0)
        y = (h - 1.0)
        while (y >= 0.0):
            cell = ((y * w) + x)
            if ((port_get(matched, cell) == 0.0) and (port_get(data, (3.0 + cell)) != -(1.0))):
                port_put(grid, ((bottom * w) + x), port_get(data, (3.0 + cell)))
                bottom -= 1.0
            y -= 1.0
        x += 1.0
    result = [count]
    i = 0.0
    while (i < port_length(grid)):
        port_push(result, port_get(grid, i))
        i += 1.0
    return result
