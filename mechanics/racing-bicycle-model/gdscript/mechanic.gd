# Move a simple car forward and bend its direction when the wheels steer.
# racing-bicycle-model: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [x,y,heading,speed,steering,wheelbase,dt]
# Output: [new_x,new_y,new_heading]
# Radians and seconds. Kinematic no-slip low-speed model; steering magnitude must be below pi/2.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Remove a negative sign so a distance or size is not negative.
static func port_abs_num(a: float) -> float:
    return absf(a)
# Get the up/down part of a unit direction from an angle measured in radians.
static func port_sin_num(a: float) -> float:
    return sin(a)
# Get the left/right part of a unit direction from an angle measured in radians.
static func port_cos_num(a: float) -> float:
    return cos(a)
# Convert a steering angle into a turning ratio; angles here are in radians.
static func port_tan_num(a: float) -> float:
    return tan(a)

# 1. Move the car along its current facing direction.
# 2. Use steering angle, speed, and axle spacing to decide how much it turns.
# 3. Update the facing direction for the next step.
# 4. This is a simple no-skidding model, not a realistic tire or suspension simulation.
static func compute(data: Array) -> Array:
    var x: float = 0.0
    var y: float = 0.0
    var heading: float = 0.0
    var speed: float = 0.0
    var steering: float = 0.0
    var base_index: float = 0.0
    var dt: float = 0.0
    x = port_get(data, 0.0)
    y = port_get(data, 1.0)
    heading = port_get(data, 2.0)
    speed = port_get(data, 3.0)
    steering = port_get(data, 4.0)
    base_index = port_get(data, 5.0)
    dt = port_get(data, 6.0)
    if ((base_index <= 0.0) or (dt < 0.0) or (port_abs_num(steering) >= 1.5707963267948966)):
        return [-(1.0)]
    return [(x + ((speed * port_cos_num(heading)) * dt)), (y + ((speed * port_sin_num(heading)) * dt)), (heading + (((speed / base_index) * port_tan_num(steering)) * dt))]
