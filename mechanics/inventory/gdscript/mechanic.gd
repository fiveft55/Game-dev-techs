# Put items into piles without making any pile or backpack too full.
# inventory: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [item_id, amount, stack_cap, slot_limit, ...[item_id,count]]
# Output: [overflow, ...[item_id,count]]
# Numeric item IDs. Existing positive stack counts must not exceed the cap. Preserve stack order.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Return the remainder after dividing one number by another.
static func port_mod_num(a: float, b: float) -> float:
    return fmod(a,b)

# 1. Fill existing piles of the same item first.
# 2. Put leftover items into new piles while free backpack slots remain.
# 3. Never put more than the pile limit into one pile.
# 4. Return the new piles and how many items could not fit. Item numbers are labels, not
# quantities.
static func compute(data: Array) -> Array:
    var item: float = 0.0
    var amount: float = 0.0
    var cap: float = 0.0
    var slots: float = 0.0
    var result: Array = []
    var i: float = 0.0
    var kind: float = 0.0
    var count: float = 0.0
    var taken: float = 0.0
    item = port_get(data, 0.0)
    amount = port_get(data, 1.0)
    cap = port_get(data, 2.0)
    slots = port_get(data, 3.0)
    if ((amount < 0.0) or (cap <= 0.0) or (slots < 0.0) or (port_mod_num((port_length(data) - 4.0), 2.0) != 0.0) or (((port_length(data) - 4.0) / 2.0) > slots)):
        return [-(1.0)]
    result = [0.0]
    i = 4.0
    while (i < port_length(data)):
        kind = port_get(data, i)
        count = port_get(data, (i + 1.0))
        if ((count <= 0.0) or (count > cap)):
            return [-(1.0)]
        if (kind == item):
            taken = port_minimum((cap - count), amount)
            count += taken
            amount -= taken
        port_push(result, kind)
        port_push(result, count)
        i += 2.0
    while ((amount > 0.0) and (((port_length(result) - 1.0) / 2.0) < slots)):
        taken = port_minimum(cap, amount)
        port_push(result, item)
        port_push(result, taken)
        amount -= taken
    port_put(result, 0.0, amount)
    return result
