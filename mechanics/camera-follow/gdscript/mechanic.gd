# Make the camera catch up gently instead of snapping straight to its target.
# camera-follow: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [current, target, rate, dt]
# Output: [new_position]
# Exact first-order exponential smoothing toward a stationary scalar target; apply per axis.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Calculate exponential growth/decay, used here to make smooth catching-up motion.
static func port_exp_num(a: float) -> float:
    return exp(a)

# 1. Find the gap between the camera and its target.
# 2. Use the time step and follow strength to choose how much of that gap to close.
# 3. Move part of the way across the gap.
# 4. Repeat next update. Bigger strength catches up faster.
static func compute(data: Array) -> Array:
    var current: float = 0.0
    var target: float = 0.0
    var rate: float = 0.0
    var dt: float = 0.0
    var alpha: float = 0.0
    current = port_get(data, 0.0)
    target = port_get(data, 1.0)
    rate = port_get(data, 2.0)
    dt = port_get(data, 3.0)
    if ((rate < 0.0) or (dt < 0.0)):
        return [-(1.0)]
    alpha = (1.0 - port_exp_num((-(rate) * dt)))
    return [(current + ((target - current) * alpha))]
