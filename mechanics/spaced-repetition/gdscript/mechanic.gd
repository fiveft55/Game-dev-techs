# Choose when a learning question should be asked again.
# spaced-repetition: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [previous_days,correct_flag,now_seconds]
# Output: [interval_days,next_due_seconds]
# Toy doubling/reset policy, not SM-2/FSRS or a validated learning intervention. Flags must be
# zero or one.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Read the previous waiting period and whether the answer was correct.
# 2. A correct answer doubles the wait, starting at one day.
# 3. An incorrect answer resets the wait to one day.
# 4. Add that wait to the current time to get the next review time. This is a simple teaching
# example, not a proven learning model.
static func compute(data: Array) -> Array:
    var previous: float = 0.0
    var correct: float = 0.0
    var now: float = 0.0
    var days: float = 0.0
    previous = port_get(data, 0.0)
    correct = port_get(data, 1.0)
    now = port_get(data, 2.0)
    if ((previous < 0.0) or ((correct != 0.0) and (correct != 1.0))):
        return [-(1.0)]
    days = 1.0
    if (correct == 1.0):
        days = port_maximum(1.0, (previous * 2.0))
    return [days, (now + (days * 86400.0))]
