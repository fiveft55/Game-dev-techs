# Draw another player between two known positions so their movement looks less jumpy.
# snapshot-interpolation: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [t0,x0,y0,t1,x1,y1,render_time]
# Output: [x,y]
# Clamp interpolation outside the snapshot interval. Authenticate snapshots before this
# calculation.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Read an older position and a newer position, each with a time.
# 2. Find where the drawing time sits between those times.
# 3. Move the same fraction of the way between the two positions.
# 4. If drawing time is outside the pair, use the nearest endpoint rather than guessing ahead.
static func compute(data: Array) -> Array:
    var t0: float = 0.0
    var t1: float = 0.0
    var alpha: float = 0.0
    t0 = port_get(data, 0.0)
    t1 = port_get(data, 3.0)
    if (t1 <= t0):
        return [-(1.0)]
    alpha = port_maximum(0.0, port_minimum(1.0, ((port_get(data, 6.0) - t0) / (t1 - t0))))
    return [(port_get(data, 1.0) + ((port_get(data, 4.0) - port_get(data, 1.0)) * alpha)), (port_get(data, 2.0) + ((port_get(data, 5.0) - port_get(data, 2.0)) * alpha))]
