# Fix an old game state, then redo later moves so the present agrees with that correction.
# rollback-resimulation: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [initial_state,correction_tick,authoritative_state,...integer_tick_inputs]
# Output: [...corrected_state_history]
# Deterministic scalar integer movement. Tick zero is before any input. Demonstrates
# restore/replay without a dynamic callback, transport, bounded history, or side-effect dispatch.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Keep the state before and after each numbered update.
# 2. Replace the state at the corrected update with the trusted value.
# 3. Apply every later recorded input again.
# 4. Return the corrected history. Do not replay real-world side effects such as charging money.
static func compute(data: Array) -> Array:
    var initial: float = 0.0
    var tick: float = 0.0
    var authority: float = 0.0
    var n: float = 0.0
    var states: Array = []
    var state: float = 0.0
    var i: float = 0.0
    initial = port_get(data, 0.0)
    tick = port_get(data, 1.0)
    authority = port_get(data, 2.0)
    n = (port_length(data) - 3.0)
    if ((tick < 0.0) or (tick > n) or (port_floor_num(tick) != tick)):
        return [-(1.0)]
    states = [initial]
    state = initial
    i = 0.0
    while (i < n):
        state += port_get(data, (3.0 + i))
        port_push(states, state)
        i += 1.0
    port_put(states, tick, authority)
    state = authority
    i = tick
    while (i < n):
        state += port_get(data, (3.0 + i))
        port_put(states, (i + 1.0), state)
        i += 1.0
    return states
