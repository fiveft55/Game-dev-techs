# Shrink a battle-royale safe circle and hurt players standing outside it.
# shrinking-zone: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [start_x,start_y,end_x,end_y,start_radius,end_radius,started,duration,now,player_x,player
# _y,damage_rate,dt]
# Output: [center_x,center_y,radius,damage]
# Linear center and radius interpolation, clamped to phase. Damage only outside; finite
# coordinates, seconds, nonnegative rate/dt.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)

# 1. Find how far the current time is through this shrinking phase.
# 2. Move the circle center and radius partway from the old values to the new ones.
# 3. Check whether the player is outside the circle.
# 4. If outside, apply damage rate times the update duration.
static func compute(data: Array) -> Array:
    var r0: float = 0.0
    var r1: float = 0.0
    var started: float = 0.0
    var duration: float = 0.0
    var now: float = 0.0
    var rate: float = 0.0
    var dt: float = 0.0
    var alpha: float = 0.0
    var x: float = 0.0
    var y: float = 0.0
    var radius: float = 0.0
    var dx: float = 0.0
    var dy: float = 0.0
    var damage: float = 0.0
    r0 = port_get(data, 4.0)
    r1 = port_get(data, 5.0)
    started = port_get(data, 6.0)
    duration = port_get(data, 7.0)
    now = port_get(data, 8.0)
    rate = port_get(data, 11.0)
    dt = port_get(data, 12.0)
    if ((duration <= 0.0) or (r1 < 0.0) or (r1 > r0) or (rate < 0.0) or (dt < 0.0)):
        return [-(1.0)]
    alpha = port_maximum(0.0, port_minimum(1.0, ((now - started) / duration)))
    x = (port_get(data, 0.0) + ((port_get(data, 2.0) - port_get(data, 0.0)) * alpha))
    y = (port_get(data, 1.0) + ((port_get(data, 3.0) - port_get(data, 1.0)) * alpha))
    radius = (r0 + ((r1 - r0) * alpha))
    dx = (port_get(data, 9.0) - x)
    dy = (port_get(data, 10.0) - y)
    damage = 0.0
    if (((dx * dx) + (dy * dy)) > (radius * radius)):
        damage = (rate * dt)
    return [x, y, radius, damage]
