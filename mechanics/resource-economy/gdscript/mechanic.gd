# Buy or produce something only if you can pay its whole cost.
# resource-economy: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [resource_count,...balances,...costs,...outputs]
# Output: [success_flag,...resulting_balances]
# Fixed resource indices replace dictionary keys. Integer resources; a failed purchase returns
# unchanged balances.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Check every required resource before changing anything.
# 2. If any resource is short, leave the balances alone.
# 3. Otherwise subtract all costs and add all outputs.
# 4. This is local arithmetic; a shared online economy needs a real database transaction too.
static func compute(data: Array) -> Array:
    var n: float = 0.0
    var success: float = 0.0
    var i: float = 0.0
    var result: Array = []
    var balance: float = 0.0
    var cost: float = 0.0
    var output: float = 0.0
    n = port_get(data, 0.0)
    if ((n < 1.0) or (port_length(data) != (1.0 + (3.0 * n)))):
        return [-(1.0)]
    success = 1.0
    i = 0.0
    while (i < n):
        balance = port_get(data, (1.0 + i))
        cost = port_get(data, ((1.0 + n) + i))
        output = port_get(data, ((1.0 + (2.0 * n)) + i))
        if ((balance < 0.0) or (cost < 0.0) or (output < 0.0)):
            return [-(1.0)]
        if (balance < cost):
            success = 0.0
        i += 1.0
    result = [success]
    i = 0.0
    while (i < n):
        balance = port_get(data, (1.0 + i))
        if (success == 1.0):
            balance += (port_get(data, ((1.0 + (2.0 * n)) + i)) - port_get(data, ((1.0 + n) + i)))
        port_push(result, balance)
        i += 1.0
    return result
