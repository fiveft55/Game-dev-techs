# Update an old decoded save record into the current small save format.
# save-migration: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [version,gold]
# Output: [version_2,gold]
# Migration of an already decoded minimal save record; intentionally NOT a JSON parser or general
# inventory serializer. Engine serialization must validate keys, size, types and nonnegative
# integer counts before calling.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Read the format version and the gold count.
# 2. Accept supported old/current versions only.
# 3. Reject negative or fractional gold counts.
# 4. Return version two with the same gold amount. Reading and validating JSON text is a
# separate job in these native kernels.
static func compute(data: Array) -> Array:
    var version: float = 0.0
    var gold: float = 0.0
    version = port_get(data, 0.0)
    gold = port_get(data, 1.0)
    if (((version != 1.0) and (version != 2.0)) or (gold < 0.0) or (port_floor_num(gold) != gold)):
        return [-(1.0)]
    return [2.0, gold]
