# Find the shortest walking route through a small square-tile map.
# grid-pathfinding: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width, height, start_cell, goal_cell, ...row_major_grid]
# Output: [...path_cell_ids] or [] if unreachable
# Cell ID is y*width+x; zero tiles are walkable. BFS with equal-cost four-neighbor movement.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Start on the player tile and put it in a waiting line.
# 2. Check nearby tiles: right, left, down, and up. Skip walls and already checked tiles.
# 3. Remember which tile led to each new tile.
# 4. When the target is found, follow those memories backward and reverse them to get the route.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var start: float = 0.0
    var goal: float = 0.0
    var n: float = 0.0
    var parent: Array = []
    var queue: Array = []
    var i: float = 0.0
    var head: float = 0.0
    var reverse: Array = []
    var cell: float = 0.0
    var result: Array = []
    var x: float = 0.0
    var y: float = 0.0
    var direction: float = 0.0
    var nx: float = 0.0
    var ny: float = 0.0
    var other: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    start = port_get(data, 2.0)
    goal = port_get(data, 3.0)
    n = (w * h)
    if ((w < 1.0) or (h < 1.0) or (start < 0.0) or (goal < 0.0) or (start >= n) or (goal >= n) or (port_length(data) != (n + 4.0))):
        return []
    if ((port_get(data, (4.0 + start)) != 0.0) or (port_get(data, (4.0 + goal)) != 0.0)):
        return []
    parent = []
    queue = [start]
    i = 0.0
    while (i < n):
        port_push(parent, -(1.0))
        i += 1.0
    port_put(parent, start, start)
    head = 0.0
    while (head < port_length(queue)):
        cell = port_get(queue, head)
        head += 1.0
        if (cell == goal):
            break
        x = (cell - (w * port_floor_num((cell / w))))
        y = port_floor_num((cell / w))
        direction = 0.0
        while (direction < 4.0):
            nx = x
            ny = y
            if (direction == 0.0):
                nx += 1.0
            if (direction == 1.0):
                nx -= 1.0
            if (direction == 2.0):
                ny += 1.0
            if (direction == 3.0):
                ny -= 1.0
            other = ((ny * w) + nx)
            if ((nx >= 0.0) and (nx < w) and (ny >= 0.0) and (ny < h)):
                if ((port_get(parent, other) == -(1.0)) and (port_get(data, (4.0 + other)) == 0.0)):
                    port_put(parent, other, cell)
                    port_push(queue, other)
            direction += 1.0
    if (port_get(parent, goal) == -(1.0)):
        return []
    reverse = []
    cell = goal
    while (cell != start):
        port_push(reverse, cell)
        cell = port_get(parent, cell)
    port_push(reverse, start)
    result = []
    i = (port_length(reverse) - 1.0)
    while (i >= 0.0):
        port_push(result, port_get(reverse, i))
        i -= 1.0
    return result
