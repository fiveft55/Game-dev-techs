# Let a map editor undo and redo painting a tile.
# level-editor-undo: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [width,height,...[operation,cell,value]]
# Output: [...final_grid]
# Operations: 0 paint, 1 undo, 2 redo. Cell ID is y*width+x. New paint discards the redo branch.
# Ignored unused cell/value fields must still be supplied.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Replace a number at an existing position in the list.
static func port_put(a: Array, i: float, v: float) -> void:
# Read one number at a zero-based position; stop if that position does not exist.
    port_get(a, i)
    a[int(i)] = v
# Add one number to the end of the list.
static func port_push(a: Array, v: float) -> void:
    a.append(v)

# 1. Before painting, remember the old tile and the new tile.
# 2. Undo restores the old tile and moves backward in the edit history.
# 3. Redo puts the new tile back and moves forward.
# 4. Painting after undo throws away the abandoned future edits.
static func compute(data: Array) -> Array:
    var w: float = 0.0
    var h: float = 0.0
    var grid: Array = []
    var history: Array = []
    var cursor: float = 0.0
    var i: float = 0.0
    var operation: float = 0.0
    var cell: float = 0.0
    var value: float = 0.0
    var kept: Array = []
    var j: float = 0.0
    w = port_get(data, 0.0)
    h = port_get(data, 1.0)
    if ((w < 1.0) or (h < 1.0)):
        return [-(1.0)]
    grid = []
    history = []
    cursor = 0.0
    i = 0.0
    while (i < (w * h)):
        port_push(grid, 0.0)
        i += 1.0
    i = 2.0
    while (i < port_length(data)):
        operation = port_get(data, i)
        cell = port_get(data, (i + 1.0))
        value = port_get(data, (i + 2.0))
        if (operation == 0.0):
            if ((cell < 0.0) or (cell >= (w * h))):
                return [-(1.0)]
            kept = []
            j = 0.0
            while (j < (cursor * 3.0)):
                port_push(kept, port_get(history, j))
                j += 1.0
            history = kept.duplicate()
            port_push(history, cell)
            port_push(history, port_get(grid, cell))
            port_push(history, value)
            cursor += 1.0
            port_put(grid, cell, value)
        else:
            if ((operation == 1.0) and (cursor > 0.0)):
                cursor -= 1.0
                port_put(grid, port_get(history, (cursor * 3.0)), port_get(history, ((cursor * 3.0) + 1.0)))
            else:
                if ((operation == 2.0) and ((cursor * 3.0) < port_length(history))):
                    port_put(grid, port_get(history, (cursor * 3.0)), port_get(history, ((cursor * 3.0) + 2.0)))
                    cursor += 1.0
        i += 3.0
    return grid
