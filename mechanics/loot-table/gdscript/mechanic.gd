# Choose an item from a weighted prize list.
# loot-table: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [ticket,...[item_id,positive_integer_weight]]
# Output: [selected_item_id]
# Caller supplies a uniform integer ticket in [0,total_weight). This separates weighted selection
# from PRNG/security policy and permits exact boundary tests.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Count how many numbers are in this list.
static func port_length(a: Array) -> float:
    return float(a.size())
# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Imagine each item owns a strip of numbered raffle tickets.
# 2. Bigger weights give an item more tickets.
# 3. Find which item owns the supplied ticket number.
# 4. Return that item. Another part of the game must choose a fair ticket; this code does not
# generate secure randomness.
static func compute(data: Array) -> Array:
    var ticket: float = 0.0
    var total: float = 0.0
    var i: float = 0.0
    var weight: float = 0.0
    ticket = port_get(data, 0.0)
    if ((ticket < 0.0) or (port_floor_num(ticket) != ticket)):
        return [-(1.0)]
    total = 0.0
    i = 1.0
    while (i < port_length(data)):
        weight = port_get(data, (i + 1.0))
        if ((weight <= 0.0) or (port_floor_num(weight) != weight)):
            return [-(1.0)]
        total += weight
        i += 2.0
    if (ticket >= total):
        return [-(1.0)]
    i = 1.0
    while (i < port_length(data)):
        weight = port_get(data, (i + 1.0))
        if (ticket < weight):
            return [port_get(data, i)]
        ticket -= weight
        i += 2.0
    return [-(1.0)]
