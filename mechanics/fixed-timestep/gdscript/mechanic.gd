# Make the game take equal-sized time steps, even when the screen draws at different speeds.
# fixed-timestep: original MIT-licensed native educational port.
# Generated by tools/ports/generate.py; edit the specification to preserve parity.
# Input: [accumulator, elapsed, step, max_elapsed]
# Output: [steps, remainder]
# Seconds. Negative clock values or nonpositive step return [-1]. Excess elapsed time is
# deliberately dropped.
# Precondition: finite, correctly shaped data; integer indices/counts/IDs.
# See ../PORTS.md for examples, limits, and the shared test fixtures.

extends RefCounted

# Read one number at a zero-based position; stop if that position does not exist.
static func port_get(a: Array, i: float) -> float:
    assert(i >= 0 and i < a.size() and floor(i) == i, "index")
    return float(a[int(i)])
# Choose the smaller of two numbers.
static func port_minimum(a: float, b: float) -> float:
    return minf(a,b)
# Choose the larger of two numbers.
static func port_maximum(a: float, b: float) -> float:
    return maxf(a,b)
# Round down to a whole number; minus 0.1 becomes minus 1.
static func port_floor_num(a: float) -> float:
    return floor(a)

# 1. Imagine a bucket collecting seconds as the game runs.
# 2. Take one scoop of time for each game update.
# 3. Keep the leftover time for the next update.
# 4. After a big pause, throw away excess time so the game does not spend forever catching up.
static func compute(data: Array) -> Array:
    var a: float = 0.0
    var elapsed: float = 0.0
    var step: float = 0.0
    var cap: float = 0.0
    var steps: float = 0.0
    a = port_get(data, 0.0)
    elapsed = port_get(data, 1.0)
    step = port_get(data, 2.0)
    cap = port_get(data, 3.0)
    if ((a < 0.0) or (elapsed < 0.0) or (step <= 0.0) or (cap < 0.0)):
        return [-(1.0)]
    a = (a + port_minimum(elapsed, cap))
    steps = port_floor_num(((a + 1e-12) / step))
    return [steps, port_maximum(0.0, (a - (steps * step)))]
